{
  "name": "Renon Power IFL Hybrid (beta)",
  "uart": {
    "baud_rate": 9600,
    "data_bits": 8,
    "parity": "none",
    "stop_bits": 1
  },
  "modbus": {
    "slave_address": 1,
    "poll_interval_ms": 5000
  },
  "registers": [
    {
      "name": "pv1_total_power",
      "label": "PV1 Power",
      "address": 8831,
      "function_code": 3,
      "value_type": "U_WORD",
      "unit": "W",
      "multiplier": 1
    },
    {
      "name": "pv2_total_power",
      "label": "PV2 Power",
      "address": 8833,
      "function_code": 3,
      "value_type": "U_WORD",
      "unit": "W",
      "multiplier": 1
    },
    {
      "name": "measured_power",
      "label": "Grid Power",
      "address": 8836,
      "function_code": 3,
      "value_type": "S_DWORD",
      "unit": "W",
      "multiplier": 1
    },
    {
      "name": "total_consumption_power",
      "label": "Load Power",
      "address": 8840,
      "function_code": 3,
      "value_type": "U_DWORD",
      "unit": "W",
      "multiplier": 1
    },
    {
      "name": "battery_power",
      "label": "Battery Power",
      "address": 12618,
      "function_code": 3,
      "value_type": "S_WORD",
      "unit": "W",
      "multiplier": 1
    },
    {
      "name": "battery_level",
      "label": "Battery SOC",
      "address": 12613,
      "function_code": 3,
      "value_type": "U_WORD",
      "unit": "%",
      "multiplier": 0.1
    },
    {
      "name": "pv1_total_power_p_v",
      "label": "PV1 Voltage",
      "address": 5776,
      "function_code": 3,
      "value_type": "U_WORD",
      "unit": "V",
      "multiplier": 0.1
    },
    {
      "name": "pv1_total_power_p_i",
      "label": "PV1 Current",
      "address": 5777,
      "function_code": 3,
      "value_type": "U_WORD",
      "unit": "A",
      "multiplier": 0.1
    },
    {
      "name": "pv2_total_power_p_v",
      "label": "PV2 Voltage",
      "address": 5778,
      "function_code": 3,
      "value_type": "U_WORD",
      "unit": "V",
      "multiplier": 0.1
    },
    {
      "name": "pv2_total_power_p_i",
      "label": "PV2 Current",
      "address": 5779,
      "function_code": 3,
      "value_type": "U_WORD",
      "unit": "A",
      "multiplier": 0.1
    },
    {
      "name": "grid_voltage",
      "label": "Grid Voltage",
      "address": 12560,
      "function_code": 3,
      "value_type": "U_WORD",
      "unit": "V",
      "multiplier": 0.1
    },
    {
      "name": "grid_current",
      "label": "Grid Current",
      "address": 12561,
      "function_code": 3,
      "value_type": "U_WORD",
      "unit": "A",
      "multiplier": 0.1
    },
    {
      "name": "battery_voltage",
      "label": "Battery Voltage",
      "address": 12608,
      "function_code": 3,
      "value_type": "U_WORD",
      "unit": "V",
      "multiplier": 0.1
    },
    {
      "name": "battery_current",
      "label": "Battery Current",
      "address": 12609,
      "function_code": 3,
      "value_type": "S_WORD",
      "unit": "A",
      "multiplier": 0.01
    },
    {
      "name": "grid_frequency",
      "label": "Grid Frequency",
      "address": 12569,
      "function_code": 3,
      "value_type": "U_WORD",
      "unit": "Hz",
      "multiplier": 0.01
    }
  ],
  "derived": [
    {
      "name": "pv_total_power",
      "label": "PV Total Power",
      "unit": "W",
      "sum_of": [
        "pv1_total_power",
        "pv2_total_power"
      ]
    }
  ]
}
